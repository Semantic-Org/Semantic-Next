{
  "name": "semantic-ui-vscode",
  "displayName": "Semantic UI",
  "description": "Language support for Semantic UI templates and components",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:javascript"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.sui",
        "path": "../../sui.tmlanguage.json",
        "injectTo": ["text.html.basic"]
      }
    ],
    "languages": [
      {
        "id": "html",
        "extensions": [".html"]
      }
    ]
  },
  "dependencies": {
    "glob": "^10.0.0",
    "typescript": "^5.0.0",
    "vscode-languageclient": "^9.0.0",
    "vscode-languageserver": "^9.0.0",
    "vscode-languageserver-textdocument": "^1.0.0"
  },
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  }
}
