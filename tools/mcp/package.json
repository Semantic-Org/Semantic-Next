{
  "name": "@semantic-ui/mcp",
  "version": "0.1.0",
  "description": "MCP server for Semantic UI component specs",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sui-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:vercel": "node build.js",
    "deploy": "wireit",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "wireit": {
    "deploy": {
      "command": "npx vercel --prod",
      "dependencies": [
        "build:vercel"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@semantic-ui/reactivity": "*",
    "@semantic-ui/specs": "*",
    "@semantic-ui/compiler": "*",
    "@semantic-ui/utils": "*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  }
}
