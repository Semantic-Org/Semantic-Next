{
  "name": "SUI Template",
  "scopeName": "source.sui.template",
  "injectionSelector": "L:text.html -comment -source.css -source.js",

  "patterns": [
    { "include": "#control-structures" },
    { "include": "#sui-expressions" }
  ],

  "repository": {
    "sui-expressions": {
      "patterns": [
        {
          "name": "meta.embedded.expression.sui",
          "begin": "\\{(?![{<])",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.begin.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        }
      ]
    },

    "expression-content": {
      "patterns": [
        { "include": "#keywords" },
        { "include": "#template-reference" },
        { "include": "#operators" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#variables-and-functions" },
        { "include": "#parentheses" }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sui",
          "match": "#(if|each|async|snippet|rerender|guard|html)\\b"
        },
        {
          "name": "keyword.control.sui",
          "match": "\\/(if|each|async|snippet|rerender|guard)\\b"
        },
        {
          "name": "keyword.control.sui",
          "match": "\\b(else\\s+if|else)\\b"
        },
        {
          "name": "keyword.control.sui",
          "match": "\\b(loading|before|error|catch)\\b"
        },
        {
          "name": "keyword.control.sui",
          "match": "\\b(in|as)\\b"
        },
        {
          "name": "keyword.operator.logical.sui",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.this.sui",
          "match": "\\bthis\\b"
        }
      ]
    },

    "template-reference": {
      "patterns": [
        {
          "name": "keyword.control.sui",
          "match": ">(\\s*)(slot|template|snippet)\\b",
          "captures": {
            "0": { "name": "keyword.control.sui" }
          }
        },
        {
          "name": "keyword.control.sui",
          "match": ">\\s*(?=[a-zA-Z_])"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sui",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.sui",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.ternary.sui",
          "match": "[?:]"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sui",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sui",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.sui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sui",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.sui",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },

    "booleans": {
      "name": "constant.language.boolean.sui",
      "match": "\\b(true|false)\\b"
    },

    "variables-and-functions": {
      "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b",
      "name": "variable.other.readwrite.sui"
    },

    "parentheses": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#expression-content" }
      ]
    },

    "control-structures": {
      "patterns": [
        {
          "name": "meta.block.each.sui",
          "begin": "(\\{)\\s*(#each)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            {
              "match": "\\b(in|as)\\b",
              "name": "keyword.control.sui"
            },
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.if.sui",
          "begin": "(\\{)\\s*(#if)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.async.sui",
          "begin": "(\\{)\\s*(#async)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            {
              "match": "\\b(as)\\b",
              "name": "keyword.control.sui"
            },
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.snippet.sui",
          "begin": "(\\{)\\s*(#snippet)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.rerender.sui",
          "begin": "(\\{)\\s*(#rerender)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.guard.sui",
          "begin": "(\\{)\\s*(#guard)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.html.sui",
          "begin": "(\\{)\\s*(#html)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.else-if.sui",
          "begin": "(\\{)\\s*(else\\s+if)\\s+",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.block.else.sui",
          "match": "(\\{)\\s*(else)\\s*(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" },
            "3": { "name": "punctuation.definition.block.end.sui" }
          }
        },
        {
          "name": "meta.block.async-section.sui",
          "match": "(\\{)\\s*(loading|before|error|catch)(\\s+as\\s+\\w+)?\\s*(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" },
            "3": { "name": "keyword.control.sui" },
            "4": { "name": "punctuation.definition.block.end.sui" }
          }
        },
        {
          "name": "meta.block.close.sui",
          "match": "(\\{)\\s*(\\/(?:if|each|async|snippet|rerender|guard))\\s*(\\})",
          "captures": {
            "1": { "name": "punctuation.definition.block.begin.sui" },
            "2": { "name": "keyword.control.sui" },
            "3": { "name": "punctuation.definition.block.end.sui" }
          }
        }
      ]
    }
  }
}
