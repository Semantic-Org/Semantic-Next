{
  "name": "semantic-ui-vscode",
  "displayName": "Semantic UI",
  "description": "VS Code extension for Semantic UI — syntax highlighting and LSP client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:html"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "source.sui",
        "path": "../../sui.tmlanguage.json",
        "injectTo": ["text.html.basic"]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
