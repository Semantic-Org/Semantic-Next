{
  "name": "@semantic-ui/core",
  "version": "0.10.9",
  "title": "Semantic UI Core",
  "description": "Semantic empowers designers and developers by creating a shared vocabulary for UI.",
  "homepage": "http://next.semantic-ui.com",
  "author": "Jack Lukic <jack@semantic-ui.com>",
  "main": "src/semantic-ui.js",
  "module": "src/semantic-ui.js",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/**",
    "src/**"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/semantic-ui.js",
      "browser": "./dist/cdn/semantic-ui.min.js",
      "bundled": "./dist/semantic-ui.min.js",
      "default": "./src/semantic-ui.js"
    },
    "./examples": {
      "import": "./examples/index.js",
      "default": "./examples/index.js"
    },
    "./page": {
      "import": "./src/semantic-ui.css",
      "default": "./src/semantic-ui.css"
    },
    "./button": {
      "import": "./src/components/button/index.js",
      "browser": "./dist/cdn/button.min.js",
      "bundled": "./dist/bundled/button.min.js",
      "default": "./src/components/button/index.js"
    },
    "./card": {
      "import": "./src/components/card/index.js",
      "browser": "./dist/cdn/card.min.js",
      "bundled": "./dist/bundled/card.min.js",
      "default": "./src/components/card/index.js"
    },
    "./container": {
      "import": "./src/components/container/index.js",
      "browser": "./dist/cdn/container.min.js",
      "bundled": "./dist/bundled/container.min.js",
      "default": "./src/components/container/index.js"
    },
    "./icon": {
      "import": "./src/components/icon/index.js",
      "browser": "./dist/cdn/icon.min.js",
      "bundled": "./dist/bundled/icon.min.js",
      "default": "./src/components/icon/index.js"
    },
    "./input": {
      "import": "./src/components/input/index.js",
      "browser": "./dist/cdn/input.min.js",
      "bundled": "./dist/bundled/input.min.js",
      "default": "./src/components/input/index.js"
    },
    "./label": {
      "import": "./src/components/label/index.js",
      "browser": "./dist/cdn/label.min.js",
      "bundled": "./dist/bundled/label.min.js",
      "default": "./src/components/label/index.js"
    },
    "./menu": {
      "import": "./src/components/menu/index.js",
      "browser": "./dist/cdn/menu.min.js",
      "bundled": "./dist/bundled/menu.min.js",
      "default": "./src/components/menu/index.js"
    },
    "./modal": {
      "import": "./src/components/modal/index.js",
      "browser": "./dist/cdn/modal.min.js",
      "bundled": "./dist/bundled/modal.min.js",
      "default": "./src/components/modal/index.js"
    },
    "./rail": {
      "import": "./src/components/rail/index.js",
      "browser": "./dist/cdn/rail.min.js",
      "bundled": "./dist/bundled/rail.min.js",
      "default": "./src/components/rail/index.js"
    },
    "./segment": {
      "import": "./src/components/segment/index.js",
      "browser": "./dist/cdn/segment.min.js",
      "bundled": "./dist/bundled/segment.min.js",
      "default": "./src/components/segment/index.js"
    },
    "./theme": {
      "import": "./src/themes/base/base.css",
      "default": "./src/themes/base/base.css"
    },
    "./theme/global": {
      "import": "./src/themes/base/global/global-theme.css",
      "default": "./src/themes/base/global/global-theme.css"
    },
    "./theme/button": {
      "import": "./src/themes/base/button/button-theme.css",
      "default": "./src/themes/base/button/button-theme.css"
    },
    "./theme/card": {
      "import": "./src/themes/base/card/card-theme.css",
      "default": "./src/themes/base/card/card-theme.css"
    },
    "./theme/container": {
      "import": "./src/themes/base/container/container-theme.css",
      "default": "./src/themes/base/container/container-theme.css"
    },
    "./theme/icon": {
      "import": "./src/themes/base/icon/icon-theme.css",
      "default": "./src/themes/base/icon/icon-theme.css"
    },
    "./theme/input": {
      "import": "./src/themes/base/input/input-theme.css",
      "default": "./src/themes/base/input/input-theme.css"
    },
    "./theme/label": {
      "import": "./src/themes/base/label/label-theme.css",
      "default": "./src/themes/base/label/label-theme.css"
    },
    "./theme/menu": {
      "import": "./src/themes/base/menu/menu-theme.css",
      "default": "./src/themes/base/menu/menu-theme.css"
    },
    "./theme/modal": {
      "import": "./src/themes/base/modal/modal-theme.css",
      "default": "./src/themes/base/modal/modal-theme.css"
    },
    "./theme/rail": {
      "import": "./src/themes/base/rail/rail-theme.css",
      "default": "./src/themes/base/rail/rail-theme.css"
    }
  },
  "scripts": {
    "build": "wireit",
    "build:deps": "wireit",
    "build:cdn": "wireit",
    "dev": "wireit",
    "build-docs": "wireit",
    "serve": "wireit",
    "watch": "wireit",
    "publish": "wireit",
    "update-version": "wireit",
    "test:case": "wireit",
    "prettify": "prettierx ./ --write --ignore-unknown",
    "format": "npx dprint fmt",
    "test": "vitest --c tests/configs/vitest/vitest.config.js",
    "test:ui": "vitest --ui --c tests/configs/vitest/vitest-ui.config.js",
    "ci:coverage": "vitest --c tests/configs/vitest/ci-coverage.config.js",
    "ci:test": "vitest --c tests/configs/vitest/ci-test-all.config.js",
    "ci:test:unit": "vitest --c tests/configs/vitest/ci-test-unit.config.js",
    "ci:test:browser": "vitest --c tests/configs/vitest/ci-test-browser.config.js"
  },
  "wireit": {
    "build": {
      "command": "node ./internal-packages/scripts/src/build-ui-deps.js"
    },
    "build:ui-deps": {
      "command": "node ./internal-packages/scripts/src/build-ui-deps.js"
    },
    "build:ui-components": {
      "command": "node ./internal-packages/scripts/src/build-ui-components.js"
    },
    "build:esm": {
      "command": "node ./internal-packages/scripts/src/build-esm.js"
    },
    "build:bundle": {
      "command": "node ./internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ./internal-packages/scripts/src/build-cdn.js"
    },
    "watch": {
      "command": "node ./tasks/watch.js",
      "service": true
    },
    "dev": {
      "command": "cd docs && npm install && npx link ../ && npm run dev",
      "dependencies": [
        "watch"
      ]
    },
    "build-docs": {
      "command": "cd docs && npm install && npx link ../ && npm run build",
      "dependencies": [
        "build"
      ]
    },
    "build:packages": {
      "dependencies": [
        "./packages/component:build",
        "./packages/query:build",
        "./packages/reactivity:build",
        "./packages/renderer:build",
        "./packages/specs:build",
        "./packages/templating:build",
        "./packages/utils:build"
      ]
    },
    "serve:docs": {
      "command": "cd docs && npm run dev",
      "service": true
    },
    "serve": {
      "command": "node ./tasks/serve.js",
      "service": true
    },
    "build:docs": {
      "command": "cd docs && npm run build"
    },
    "publish": {
      "command": "node ./scripts/publish.js",
      "dependencies": [
        "update-version",
        "build"
      ]
    },
    "update-version": {
      "command": "node ./scripts/update-versions.js"
    }
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "dependencies": {
    "@semantic-ui/component": "^0.10.9",
    "@semantic-ui/esbuild-log": "^0.0.1",
    "@semantic-ui/specs": "^0.10.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "^22.13.13",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "@vitest/browser": "^3.0.9",
    "@vitest/coverage-istanbul": "^3.0.9",
    "@vitest/ui": "^3.0.9",
    "chalk": "^5.4.1",
    "dprint": "^0.49.1",
    "esbuild": "^0.25.1",
    "glob": "^11.0.1",
    "inquirer": "^12.5.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.51.1",
    "semver": "^7.7.1",
    "simple-git-hooks": "^2.12.1",
    "underscore": "^1.13.7",
    "vitest": "^3.0.9",
    "wireit": "^0.14.11"
  },
  "ciDependencies": {
    "axios": "^1.6.8",
    "decompress": "^4.2.1",
    "glob": "^10.3.10"
  },
  "workspaces": [
    "internal-packages/*",
    "packages/*",
    "docs/*",
    "examples/*"
  ],
  "simple-git-hooks": {
    "pre-commit": "npx dprint fmt --staged"
  }
}
