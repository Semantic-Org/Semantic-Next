{
  "name": "@semantic-ui/internal-scripts",
  "version": "0.16.2",
  "description": "Internal build scripts for Semantic UI",
  "author": "Jack Lukic <jack@semantic-ui.com>",
  "homepage": "https://next.semantic-ui.com",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./build-bundle": {
      "import": "./src/build-bundle.js",
      "default": "./src/build-bundle.js"
    },
    "./build-cdn": {
      "import": "./src/build-cdn.js",
      "default": "./src/build-cdn.js"
    },
    "./build-esm": {
      "import": "./src/build-esm.js",
      "default": "./src/build-esm.js"
    }
  },
  "private": true,
  "dependencies": {
    "@semantic-ui/esbuild-callback": "^0.16.2",
    "@semantic-ui/esbuild-log": "^0.16.2",
    "@semantic-ui/esbuild-resolve-bare-imports": "^0.16.2",
    "@semantic-ui/specs": "^0.16.2",
    "esbuild": "^0.25.1",
    "tiny-glob": "^0.2.9"
  },
  "devDependencies": {
    "@chialab/esbuild-plugin-worker": "^0.18.1"
  }
}
