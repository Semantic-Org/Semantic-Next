{
  "name": "@semantic-ui/internal-scripts",
  "version": "0.10.2",
  "description": "Internal build scripts for Semantic UI",
  "author": "Jack Lukic <jack@semantic-ui.com>",
  "homepage": "https://next.semantic-ui.com",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "sideEffects": false,
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./build": {
      "import": "./src/tasks/build.js",
      "default": "./src/tasks/build.js"
    },
    "./build-cdn": {
      "import": "./src/tasks/build-cdn.js",
      "default": "./src/tasks/build-cdn.js"
    },
    "./build-ui-framework": {
      "import": "./src/tasks/build-ui-framework.js",
      "default": "./src/tasks/build-ui-framework.js"
    },
    "./build-ui-cdn": {
      "import": "./src/tasks/build-ui-cdn.js",
      "default": "./src/tasks/build-ui-cdn.js"
    },
    "./build-deps": {
      "import": "./src/tasks/build-deps.js",
      "default": "./src/tasks/build-deps.js"
    },
    "./utils": {
      "import": "./src/utils/index.js",
      "default": "./src/utils/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "build:minified": "wireit",
    "build:cdn": "wireit",
    "build:ui-framework": "wireit",
    "build:ui-cdn": "wireit",
    "build:deps": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:cdn",
        "build:ui-framework",
        "build:ui-cdn"
      ]
    },
    "build:minified": {
      "command": "node ./src/do-build-minified.js"
    },
    "build:cdn": {
      "command": "node ./src/do-build-cdn.js"
    },
    "build:ui-framework": {
      "command": "node ./src/do-build-ui-framework.js"
    },
    "build:ui-cdn": {
      "command": "node ./src/do-build-ui-cdn.js"
    },
    "build:deps": {
      "command": "node ./src/do-build-deps.js"
    }
  },
  "private": true,
  "dependencies": {
    "@semantic-ui/esbuild-resolve-bare-imports": "^0.10.2",
    "chalk": "^5.4.1",
    "esbuild": "^0.25.1"
  }
}