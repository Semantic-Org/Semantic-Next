{
  "permissions": {
    "allow": [
      "mcp__semantic-ui__*"
    ]
  },
  "mcpServers": {
    "semantic-ui": {
      "command": "bash",
      "args": ["-c", "cd tools/mcp && npm run build --silent && node dist/index.js"]
