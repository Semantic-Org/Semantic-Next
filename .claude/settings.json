{
  "permissions": {
    "allow": [
      "mcp__semantic-ui__*"
    ]
  },
  "mcpServers": {
    "semantic-ui": {
      "command": "bash",
      "args": [
        "-c",
        "cd tools/mcp && npm run build --silent && node dist/index.js"
      ]
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/pr-description\""
          }
        ]
      }
    ]
  }
}
