{
  "name": "@semantic-ui/specs",
  "version": "0.10.9",
  "title": "Semantic UI Specs",
  "description": "Component specifications and definitions for UI components",
  "author": "Jack Lukic",
  "license": "ISC",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/browser/index.min.js",
      "importmap": "./dist/cdn/index.min.js"
    }
  },
  "scripts": {
    "build": "wireit"
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@semantic-ui/utils": "^0.10.9"
  },
  "devDependencies": {
    "esbuild": "^0.25.1"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:bundle",
        "build:cdn"
      ]
    },
    "build:minified": {
      "command": "node ../../internal-packages/scripts/src/build-minified.js"
    },
    "build:bundle": {
      "command": "node ../../internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/build-cdn.js"
    }
  }
}
