{
  "name": "@semantic-ui/specs",
  "title": "Semantic UI Specs",
  "description": "Component specifications and definitions for UI components",
  "author": "Jack Lukic",
  "license": "ISC",
  "version": "0.18.0",
  "sideEffects": false,
  "type": "module",
  "main": "src/browser.js",
  "module": "src/browser.js",
  "exports": {
    ".": {
      "node": "./src/server.js",
      "browser": "./src/browser.js",
      "import": "./src/browser.js",
      "default": "./src/browser.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "generate:icons": "wireit",
    "icons:generate-css": "wireit",
    "icons:generate-meta": "wireit",
    "icons:download-svg": "wireit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@semantic-ui/utils": "^0.18.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.40.2",
    "@phosphor-icons/core": "^2.1.1",
    "@semantic-ui/internal-scripts": "^0.18.0",
    "@tabler/icons": "^3.36.1",
    "@vitest/browser-playwright": "^4.0.18",
    "heroicons": "^2.2.0",
    "lucide-static": "^0.563.0",
    "vitest": "^4.0.18"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:esm",
        "build:bundle",
        "build:cdn"
      ]
    },
    "build:esm": {
      "command": "node ../../internal-packages/scripts/src/build-esm.js"
    },
    "build:bundle": {
      "command": "node ../../internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/build-cdn.js"
    },
    "generate:icons": {
      "dependencies": [
        "icons:generate-css",
        "icons:generate-meta",
        "icons:download-svg"
      ]
    },
    "icons:generate-css": {
      "command": "node scripts/generate-icon-css.js"
    },
    "icons:generate-meta": {
      "command": "node scripts/generate-icon-meta.js"
    },
    "icons:download-svg": {
      "command": "node scripts/download-icon-svg.js",
      "dependencies": ["icons:generate-css"]
    }
  }
}
