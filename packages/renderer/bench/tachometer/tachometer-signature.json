{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/nicolo-ribaudo.github.io/HEAD/nicolo-ribaudo.github.io/src/assets/tachometer.schema.json",
  "root": "../../../..",
  "sampleSize": 50,
  "timeout": 3,
  "autoSampleConditions": ["0%", "5%"],
  "resolveBareModules": false,
  "benchmarks": [
    {
      "url": "signature.html",
      "browser": { "name": "chrome", "headless": true },
      "measurement": [
        { "mode": "performance", "entryName": "destructured" },
        { "mode": "performance", "entryName": "positional" }
      ]
    }
  ]
}
