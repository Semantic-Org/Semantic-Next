{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/nicolo-ribaudo.github.io/HEAD/nicolo-ribaudo.github.io/src/assets/tachometer.schema.json",
  "root": "../../../..",
  "sampleSize": 50,
  "timeout": 3,
  "autoSampleConditions": ["2%"],
  "benchmarks": [
    {
      "name": "this-change",
      "url": "ci-current-renderer-micros.html",
      "browser": { "name": "chrome", "headless": true },
      "measurement": [
        { "mode": "performance", "entryName": "micro-expr-simple-100k" },
        { "mode": "performance", "entryName": "micro-expr-lisp-50k" },
        { "mode": "performance", "entryName": "micro-expr-js-10k" },
        { "mode": "performance", "entryName": "micro-build-html-string-10k" },
        { "mode": "performance", "entryName": "micro-dom-walker-1000x15" }
      ]
    },
    {
      "name": "tip-of-tree",
      "url": "ci-baseline-renderer-micros.html",
      "browser": { "name": "chrome", "headless": true },
      "measurement": [
        { "mode": "performance", "entryName": "micro-expr-simple-100k" },
        { "mode": "performance", "entryName": "micro-expr-lisp-50k" },
        { "mode": "performance", "entryName": "micro-expr-js-10k" },
        { "mode": "performance", "entryName": "micro-build-html-string-10k" },
        { "mode": "performance", "entryName": "micro-dom-walker-1000x15" }
      ]
    }
  ]
}
