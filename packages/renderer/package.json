{
  "name": "@semantic-ui/renderer",
  "version": "0.18.0",
  "type": "module",
  "title": "Semantic UI Renderer",
  "description": "High-performance template rendering system with reactive directives",
  "author": "Jack Lukic",
  "homepage": "https://next.semantic-ui.com",
  "license": "ISC",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/bundle/index.min.js",
      "importmap": "./dist/cdn/index.min.js"
    },
    "./lit": "./src/engines/lit/renderer.js"
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "bench": "vitest bench --config vitest.bench.config.js",
    "bench:component": "tachometer --config bench/tachometer/tachometer.json",
    "bench:todo": "tachometer --config bench/tachometer/tachometer-todo.json",
    "bench:signature": "tachometer --config bench/tachometer/tachometer-signature.json"
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@semantic-ui/reactivity": "^0.18.0",
    "@semantic-ui/templating": "^0.18.0",
    "@semantic-ui/utils": "^0.18.0"
  },
  "devDependencies": {
    "@semantic-ui/compiler": "^0.18.0",
    "@semantic-ui/internal-scripts": "^0.18.0",
    "tachometer": "^0.7.2"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:esm",
        "build:bundle",
        "build:cdn"
      ]
    },
    "build:esm": {
      "command": "node ../../internal-packages/scripts/src/build-esm.js"
    },
    "build:bundle": {
      "command": "node ../../internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/build-cdn.js"
    }
  }
}
