{
  "name": "@semantic-ui/renderer",
  "version": "0.14.0",
  "title": "Semantic UI Renderer",
  "description": "High-performance template rendering system with reactive directives",
  "author": "Jack Lukic",
  "homepage": "https://next.semantic-ui.com",
  "license": "ISC",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "browser": "./dist/bundle/index.min.js",
      "importmap": "./dist/cdn/index.min.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@semantic-ui/reactivity": "^0.14.0",
    "@semantic-ui/templating": "^0.14.0",
    "@semantic-ui/utils": "^0.14.0"
  },
  "devDependencies": {
    "@semantic-ui/internal-scripts": "^0.14.0",
    "vitest": "^3.0.4"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:esm",
        "build:bundle",
        "build:cdn"
      ]
    },
    "build:esm": {
      "command": "node ../../internal-packages/scripts/src/build-esm.js"
    },
    "build:bundle": {
      "command": "node ../../internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/build-cdn.js"
    }
  }
}
