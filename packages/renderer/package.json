{
  "name": "@semantic-ui/renderer",
  "version": "0.10.0",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "production": "./dist/index.min.js",
      "importmap": "./dist/cdn/index.min.js",
      "default": "./src/index.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "Jack Lukic",
  "license": "ISC",
  "dependencies": {
    "lit": "3.2.1",
    "@semantic-ui/reactivity": "^0.10.0",
    "@semantic-ui/templating": "^0.10.0",
    "@semantic-ui/utils": "^0.10.0"
  },
  "devDependencies": {
    "vitest": "^3.0.4",
    "esbuild": "^0.25.1"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:cdn"
      ]
    },
    "build:minified": {
      "command": "node ../internal-scripts/src/build.js"
    },
    "build:cdn": {
      "command": "node ../internal-scripts/src/build-cdn.js"
    }
  }
}
