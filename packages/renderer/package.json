{
  "name": "@semantic-ui/renderer",
  "version": "0.10.1",
  "description": "High-performance template rendering system with reactive directives",
  "author": "Jack Lukic",
  "homepage": "https://next.semantic-ui.com",
  "license": "ISC",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": {
      "development": "./src/index.js",
      "importmap": "./dist/cdn/index.min.js",
      "default": "./dist/index.min.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@semantic-ui/reactivity": "^0.10.1",
    "@semantic-ui/templating": "^0.10.1",
    "@semantic-ui/utils": "^0.10.1"
  },
  "devDependencies": {
    "vitest": "^3.0.4",
    "esbuild": "^0.25.1"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:cdn"
      ]
    },
    "build:minified": {
      "command": "node ../../internal-packages/scripts/src/do-build-minified.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/do-build-cdn.js"
    }
  }
}
