{
  "name": "@semantic-ui/query",
  "version": "0.10.0",
  "main": "src/index.cjs",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "node": {
        "import": "./src/node-wrapper.js",
        "default": "./src/index.cjs"
      },
      "module": {
        "import": "./src/index.js",
        "default": "./src/index.js"
      },
      "production": "./dist/index.min.js",
      "importmap": "./dist/cdn/index.min.js",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "scripts": {
    "build": "wireit",
    "test": "vitest"
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "author": "Jack Lukic",
  "license": "ISC",
  "dependencies": {
    "@semantic-ui/utils": "^0.10.0"
  },
  "devDependencies": {
    "vitest": "^3.0.4",
    "esbuild": "^0.25.1"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:cdn"
      ]
    },
    "build:minified": {
      "command": "node ../internal-scripts/src/build.js"
    },
    "build:cdn": {
      "command": "node ../internal-scripts/src/build-cdn.js"
    }
  }
}
