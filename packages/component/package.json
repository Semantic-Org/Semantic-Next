{
  "name": "@semantic-ui/component",
  "title": "Semantic UI Component",
  "description": "A framework for creating web components.",
  "author": "Jack Lukic",
  "license": "ISC",
  "version": "0.18.0",
  "sideEffects": [
    "./src/index.js",
    "./src/engines/*/register.js"
  ],
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "browser": "./dist/bundle/index.min.js",
      "importmap": "./dist/cdn/index.min.js"
    },
    "./bare": "./src/bare.js"
  },
  "scripts": {
    "build": "wireit",
    "build:esm": "wireit",
    "build:cdn": "wireit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage"
  },
  "files": [
    "src",
    "dist",
    "types",
    "LICENSE"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@semantic-ui/compiler": "^0.18.0",
    "@semantic-ui/query": "^0.18.0",
    "@semantic-ui/reactivity": "^0.18.0",
    "@semantic-ui/renderer": "^0.18.0",
    "@semantic-ui/templating": "^0.18.0",
    "@semantic-ui/utils": "^0.18.0"
  },
  "devDependencies": {
    "@semantic-ui/internal-scripts": "^0.18.0",
    "@vitest/browser-playwright": "^4.0.18",
    "vitest": "^4.0.18"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:esm",
        "build:bundle",
        "build:cdn"
      ]
    },
    "build:esm": {
      "command": "node ../../internal-packages/scripts/src/build-esm.js"
    },
    "build:bundle": {
      "command": "node ../../internal-packages/scripts/src/build-bundle.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/build-cdn.js"
    }
  }
}
