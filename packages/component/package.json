{
  "name": "@semantic-ui/component",
  "description": "A framework for creating web components.",
  "author": "Jack Lukic",
  "license": "ISC",
  "version": "0.10.7",
  "sideEffects": false,
  "main": "src/index.js",
  "module": "src/index.js",
  "browser": "dist/browser/index.min.js",
  "unpkg": "dist/browser/index.min.js",
  "jsdelivr": "dist/browser/index.min.js",
  "cdn": "dist/browser/index.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "browser": "./dist/browser/index.min.js",
      "importmap": "./dist/cdn/index.min.js"
    }
  },
  "scripts": {
    "build": "wireit",
    "build:minified": "wireit",
    "build:cdn": "wireit",
    "test": "vitest"
  },
  "files": [
    "src",
    "dist",
    "types",
    "LICENSE"
  ],
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "@semantic-ui/query": "^0.10.7",
    "@semantic-ui/reactivity": "^0.10.7",
    "@semantic-ui/renderer": "^0.10.7",
    "@semantic-ui/templating": "^0.10.7",
    "@semantic-ui/utils": "^0.10.7"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "vitest": "^3.0.8"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:browser",
        "build:cdn"
      ]
    },
    "build:minified": {
      "command": "node ../../internal-packages/scripts/src/do-build-minified.js"
    },
    "build:browser": {
      "command": "node ../../internal-packages/scripts/src/do-build-browser.js"
    },
    "build:cdn": {
      "command": "node ../../internal-packages/scripts/src/do-build-cdn.js"
    }
  }
}
