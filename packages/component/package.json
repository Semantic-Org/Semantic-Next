{
  "name": "@semantic-ui/component",
  "description": "A framework for creating web components.",
  "author": "Jack Lukic",
  "license": "ISC",
  "version": "0.10.0",
  "sideEffects": false,
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "development": "./src/index.js",
      "default": "./dist/index.min.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "LICENSE"
  ],
  "scripts": {
    "build": "wireit",
    "test": "vitest"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:minified",
        "build:cdn"
      ]
    },
    "build:minified": {
      "dependencies": [
        "../internal-scripts:build-minified"
      ]
    },
    "build:cdn": {
      "dependencies": [
        "../internal-scripts:build-cdn"
      ]
    }
  },
  "dependencies": {
    "@semantic-ui/query": "^0.10.0",
    "@semantic-ui/reactivity": "^0.10.0",
    "@semantic-ui/renderer": "^0.10.0",
    "@semantic-ui/templating": "^0.10.0",
    "@semantic-ui/utils": "^0.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.1",
    "vitest": "^3.0.8"
  }
}
