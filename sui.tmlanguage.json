{
  "name": "SUI (UI Template)",
  "scopeName": "source.sui",
  "fileTypes": ["sui", "html"],

  "patterns": [
    { "include": "#html" },
    { "include": "#event-attributes" },
    { "include": "#sui-expressions" },
    { "include": "#control-structures" }
  ],

  "repository": {
    "html": {
      "patterns": [
        { "include": "text.html.basic" }
      ]
    },

    "event-attributes": {
      "patterns": [
        {
          "name": "meta.attribute.event.sui",
          "match": "(@)(\\w[\\w-]*)\\s*(=)",
          "captures": {
            "1": { "name": "punctuation.definition.event.sui" },
            "2": { "name": "entity.other.attribute-name.event.sui" },
            "3": { "name": "keyword.operator.assignment.sui" }
          }
        }
      ]
    },

    "sui-expressions": {
      "patterns": [
        {
          "name": "meta.template.expression.sui",
          "begin": "(\\{\\{|\\{(?!\\{))",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.sui" }
          },
          "end": "(\\}\\}|\\}(?!\\}))",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        }
      ]
    },

    "expression-content": {
      "patterns": [
        { "include": "#keywords" },
        { "include": "#template-reference" },
        { "include": "#operators" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#booleans" },
        { "include": "#inline-objects" },
        { "include": "#variables-and-functions" },
        { "include": "#parentheses" }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.block.sui",
          "match": "#(if|each|async|snippet|rerender|guard|html)\\b"
        },
        {
          "name": "keyword.control.close.sui",
          "match": "\\/(if|each|async|snippet|rerender|guard)\\b"
        },
        {
          "name": "keyword.control.branch.sui",
          "match": "\\b(else\\s+if|else)\\b"
        },
        {
          "name": "keyword.control.async-section.sui",
          "match": "\\b(loading|before|error|catch)\\b"
        },
        {
          "name": "keyword.control.iterator.sui",
          "match": "\\b(in|as)\\b"
        },
        {
          "name": "keyword.operator.logical.sui",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.this.sui",
          "match": "\\bthis\\b"
        }
      ]
    },

    "template-reference": {
      "patterns": [
        {
          "name": "keyword.control.reference.sui",
          "match": ">(\\s*)(slot|template|snippet)\\b",
          "captures": {
            "0": { "name": "keyword.control.reference.sui" }
          }
        },
        {
          "name": "keyword.control.reference.sui",
          "match": ">\\s*(?=[a-zA-Z_])"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.sui",
          "match": "(===|!==|==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.sui",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.ternary.sui",
          "match": "[?:]"
        }
      ]
    },

    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.sui",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.sui",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.sui",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.sui",
              "match": "\\\\."
            }
          ]
        }
      ]
    },

    "numbers": {
      "name": "constant.numeric.sui",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },

    "booleans": {
      "name": "constant.language.boolean.sui",
      "match": "\\b(true|false)\\b"
    },

    "variables-and-functions": {
      "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)(\\.[a-zA-Z_$][a-zA-Z0-9_$]*)*\\b",
      "name": "variable.parameter.sui"
    },

    "inline-objects": {
      "name": "meta.object.sui",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.property.sui" },
            "2": { "name": "punctuation.separator.key-value.sui" }
          }
        },
        { "include": "#expression-content" }
      ]
    },

    "parentheses": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#expression-content" }
      ]
    },

    "control-structures": {
      "patterns": [
        {
          "name": "meta.control.each.sui",
          "begin": "(\\{\\s*(#each)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.each.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            {
              "match": "\\b(in|as)\\b",
              "name": "keyword.control.in.sui"
            },
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.if.sui",
          "begin": "(\\{\\s*(#if)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.if.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.async.sui",
          "begin": "(\\{\\s*(#async)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.async.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            {
              "match": "\\b(as)\\b",
              "name": "keyword.control.as.sui"
            },
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.snippet.sui",
          "begin": "(\\{\\s*(#snippet)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.snippet.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.rerender.sui",
          "begin": "(\\{\\s*(#rerender)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.rerender.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.guard.sui",
          "begin": "(\\{\\s*(#guard)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.guard.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.html.sui",
          "begin": "(\\{\\s*(#html)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.html.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.else-if.sui",
          "begin": "(\\{\\s*(else\\s+if)\\s+)",
          "beginCaptures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.else-if.sui" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "meta.brace.curly.sui" }
          },
          "patterns": [
            { "include": "#expression-content" }
          ]
        },
        {
          "name": "meta.control.else.sui",
          "match": "(\\{\\s*(else)\\s*\\})",
          "captures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.else.sui" }
          }
        },
        {
          "name": "meta.control.async-section.sui",
          "match": "(\\{\\s*(loading|before|error|catch)(\\s+as\\s+\\w+)?\\s*\\})",
          "captures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.async-section.sui" },
            "3": { "name": "keyword.control.as.sui" }
          }
        },
        {
          "name": "meta.control.close.sui",
          "match": "(\\{\\s*(\\/(?:if|each|async|snippet|rerender|guard))\\s*\\})",
          "captures": {
            "1": { "name": "meta.brace.curly.sui" },
            "2": { "name": "keyword.control.close.sui" }
          }
        }
      ]
    }
  }
}
