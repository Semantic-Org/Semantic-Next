---
import { PerfCards } from '@components/PerfTest/PerfCards.js';
---
<html>
<body style="background-color:#000000">
<style>
  .perf-header {
    padding: 16px;
    font-family: monospace;
    color: #0f0;
    background: #111;
    border-bottom: 1px solid #333;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .perf-header h2 {
    margin: 0 0 8px;
    font-size: 16px;
    color: #fff;
  }
  .perf-metric {
    display: inline-block;
    margin-right: 20px;
    font-size: 13px;
  }
  .perf-metric .label {
    color: #888;
  }
  .perf-metric .value {
    color: #0f0;
    font-weight: bold;
  }
</style>

<div class="perf-header">
  <h2>SSR Only (no JS, no hydration)</h2>
  <span class="perf-metric" id="paint-time">
    <span class="label">paint: </span>
    <span class="value">measuring...</span>
  </span>
</div>

<PerfCards />

<script is:inline>
  performance.mark('ssr-page-start');
  requestAnimationFrame(() => {
    performance.mark('ssr-first-paint');
    performance.measure('ssr-to-paint', 'ssr-page-start', 'ssr-first-paint');
    const measure = performance.getEntriesByName('ssr-to-paint')[0];
    const el = document.querySelector('#paint-time .value');
    if (el) el.textContent = measure.duration.toFixed(2) + 'ms';
  });
</script>
</body>
</html>
