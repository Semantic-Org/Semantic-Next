---
import Body from '../layouts/Body.astro';
import '../css/layers.css';
import '../css/fonts.css';
import '@semantic-ui/core/icon/sets/lucide.css';

// Named import — side effect should register <ui-icon> via source condition
import { Icon } from '@semantic-ui/core';
---
<Body class="dark">
<div style="padding: 24px; max-width: 600px;">

  <h3 style="color: white; font-family: sans-serif; margin-top: 24px;">2. Component Reference</h3>
  <p style="color: #999; font-family: sans-serif;">Direct component usage — tests renderer check() with class</p>

  <Icon icon="heart" />

  <h3 style="color: white; font-family: sans-serif; margin-top: 24px;">3. Bare Side-Effect Import + Tag Name</h3>
  <p style="color: #999; font-family: sans-serif;">Per-component import, no named binding</p>
  <ui-icon icon="heart"></ui-icon>

</div>
</Body>
