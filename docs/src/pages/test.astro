---
import Layout from '@layouts/Layout.astro';
import '../css/layers.css';
import '../css/fonts.css';
import Body from '../layouts/Body.astro';
import { UIMenu, MenuItem } from '@semantic-ui/core'

---
<style>
  body {
    padding: 2rem;
  }
</style>
<Body>
          <UIMenu client:load selection inset class="menu" value="card-search">
            <MenuItem client:load value="card-search">Card Search</MenuItem>
            <MenuItem client:load value="fireworks-display">Fireworks</MenuItem>
            <MenuItem client:load value="advanced-ball-simulation">Ball Simulation</MenuItem>
            <MenuItem client:load value="spectrum-analyzer">Spectrum Analyzer</MenuItem>
          </UIMenu>
</Body>
