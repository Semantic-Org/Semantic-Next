---
import Body from '../layouts/Body.astro';
import '../css/layers.css';
import '../css/fonts.css';
import { UIIcon } from '@semantic-ui/core';
import '@semantic-ui/core/icon/sets/lucide.css';
---
<Body class="dark">
<div style="padding: 24px; color: white; display: flex; gap: 24px; flex-wrap: wrap; align-items: center;">
  <!-- home: all should show the same house icon -->
  <UIIcon home>home</UIIcon>
  <UIIcon icon="house">house</UIIcon>
  <UIIcon icon="homepage">homepage</UIIcon>
  <UIIcon icon="main">main</UIIcon>
</div>
</Body>
