---
import Homepage from '../layouts/Homepage.astro';
import { Code } from '@astrojs/starlight/components';
import { CodeSample } from '@components/CodeSample/CodeSample.js';
import { formatCode } from '@helpers/format-code.js';
import PlaygroundExample from '@components/PlaygroundExample/PlaygroundExample.astro';
import { CurrentTime } from '@components/CurrentTime.js'
import { UIButton, UIContainer, UICards } from '@semantic-ui/core'
import { Image } from 'astro:assets';
import logoImage from '@images/logo.png';
import { AIPrompt } from '@components/AIPrompt/AIPrompt.js';
import { AILoader } from '@components/AILoader/AILoader.js';

const code1=`
<ui-buttons>
  <ui-button subtle-negative>
    <ui-icon delete></ui-icon>
    Delete
  </ui-button>
  <ui-button>
    <ui-icon edit></ui-icon>
    Edit
  </ui-button>
  <ui-button primary>
    <ui-icon save></ui-icon>
    Save
  </ui-button>
</ui-buttons>
`.trim();
const code2=`
<current-date>
  <h3 class="header">
    Welcome {getDisplayName (getUser userId) }
  </h3>
  {#if isAdmin userId}
    <ui-buttons large>
      {#each actions}
        <ui-button {style}>
          <ui-icon {icon}>
          {text}
        </ui-button>
      {/each}
    </ui-buttons>
  {/if}
</user-panel>
`.trim();
const code3=`
{
  "tagName": "ui-button",
  "types": [
    {
      "name": "Emphasis",
      "usageLevel": 1,
      "options": [
        { "value": "primary",
          "description": "be emphasized as
            the first action" },
        { "value": "secondary" }
      ]
    },
    {
      "name": "Social Site",
      "usageLevel": 5,
      "options": [
        "instagram", "facebook", "twitter"
      ]
    }
  ],
  "variations": [
    { "name": "Size",
      "usageLevel": 1,
      "options": [
        "small", "medium", "large"
      ] },
    { "name": "Circular", "usageLevel": 3 }
  ]
}
`.trim();
const code4=`
import { defineComponent } from '@semantic-ui/component';

const template = await getText('./panel.html');
const css = await getText('./panel.css');

export const UserPanel = defineComponent({
  tagName: 'user-panel',
  template,
  css,
  defaultState: {
    users: [],
    loading: true,
  },
  createComponent: ({ state, signal }) => ({
    async loadUsers() {
      const data = await fetch('/api/users');
      state.users.set(await data.json());
      state.loading.set(false);
    },
  }),
  onCreated: ({ self }) => self.loadUsers(),
});
`.trim();

const formattedCode2 = formatCode(code2, 'sui');
const formattedCode3 = formatCode(code3, 'json');
const formattedCode4 = formatCode(code4, 'javascript');

// Hero demo script — each step is a prompt + the resulting code/UI
const demoSteps = [
  {
    prompt: 'Make a large delete button',
    cot: 'Creating button from spec',
    code: '<ui-button large>Delete</ui-button>',
    html: '<ui-button large>Delete</ui-button>',
  },
  {
    prompt: 'Add an icon',
    cot: 'Retrieving icon spec and adding icon',
    code: `<ui-button large>\n  <ui-icon delete></ui-icon>\n  Delete\n</ui-button>`,
    html: '<ui-button large><ui-icon delete></ui-icon>Delete</ui-button>',
  },
  {
    prompt: 'Add edit and save',
    cot: 'Lookup plural variation add additional icons',
    code: `<ui-buttons large>\n  <ui-button>\n    <ui-icon delete></ui-icon>\n    Delete\n  </ui-button>\n  <ui-button>\n    <ui-icon edit></ui-icon>\n    Edit\n  </ui-button>\n  <ui-button>\n    <ui-icon save></ui-icon>\n    Save\n  </ui-button>\n</ui-buttons>`,
    html: '<ui-buttons><ui-button><ui-icon delete></ui-icon>Delete</ui-button><ui-button><ui-icon edit></ui-icon>Edit</ui-button><ui-button><ui-icon save></ui-icon>Save</ui-button></ui-buttons>',
  },
  {
    prompt: 'Emphasize save',
    cot: 'Adjusting button emphasis',
    code: `<ui-buttons>\n  <ui-button subtle-negative>\n    <ui-icon delete></ui-icon>\n    Delete\n  </ui-button>\n  <ui-button>\n    <ui-icon edit></ui-icon>\n    Edit\n  </ui-button>\n  <ui-button primary>\n    <ui-icon save></ui-icon>\n    Save\n  </ui-button>\n</ui-buttons>`,
    html: '<ui-buttons><ui-button subtle-negative><ui-icon delete></ui-icon>Delete</ui-button><ui-button><ui-icon edit></ui-icon>Edit</ui-button><ui-button primary><ui-icon save></ui-icon>Save</ui-button></ui-buttons>',
  },
];


---
<Homepage>
  <aboveFold>
    <canvas id="plasma"></canvas>
    <content>
      <UIContainer>
        <div class="text">
          <h1>The UI Framework for the AI Era</h1>
          <p>Agents write it. Browsers run it. Humans read it.</p>
          <p>A web component framework with signals, expressive templates,  and an off-the-shelf UI kit. No build step from generation to execution.</p>
          <UIButton secondary href="/ui/start">View Docs</UIButton>
          <UIButton primary icon-after icon="right-chevron" href="/learn/selection">Try In 5 Minutes</UIButton>
        </div>
        <div class="visual one">
          <div class="sticky">
            <AIPrompt steps={demoSteps} dark client:load></AIPrompt>
            <div class="segment demo-segment">
              <div class="one section">
              </div>
                <div class="demo-pane">
                  <div class="pane-label">Preview</div>
                  <div class="demo-ui"></div>
                </div>
                <div class="demo-pane">
                  <div class="pane-label">Code</div>
                  <div class="demo-code"></div>
                </div>
                <div class="demo-note"></div>
              <div class="two section">
                <CodeSample
                  formattedCode={formattedCode2}
                  client:load
                  language="html"
                />
              </div>
              <div class="three section">
                <CodeSample
                  formattedCode={formattedCode3}
                  client:load
                  language="html"
                />
              </div>
              <div class="four section">
                <CodeSample
                  formattedCode={formattedCode4}
                  client:load
                  language="json"
                />
              </div>
            </div>
          </div>
        </div>
      </UIContainer>
    </content>
  </aboveFold>
  <script>
    import { createPlasma } from '../javascript/plasma.js'
    const plasma = createPlasma('#plasma', {
      // Colors — just hex
      colorFrom:       '#00405C',
      colorTo:         '#2b6fb6',
      colorShift:       0,
      fps: false,

      // Specular
      specularTint:    '#1a99e6',
      specularPower:   1.5,
      specularAmbient: 0.2,

      // Animation
      speed:       0.2,
      density:     2.5,
      brightness:  0.6,
      resolution:  1,
      // Mouse interaction
      mouse: {
        light: 2,   // specular follows cursor
        warp:  0.5,   // gravity well pulls bands
      },
    });

  </script>
  <script>
    import { $ } from '@semantic-ui/query';

    const $visual = $('.visual');
    const $sticky = $('.visual .sticky');
    const $copies = $('.tour .copy');
    const $proof = $('ribbon.proof');
    const allSections = ['one', 'two', 'three', 'four'];
    const copySections = ['two', 'three', 'four'];
    let isParked = false;

    // measure the panel's natural sticky position once (before any scroll)
    let naturalTop = null;

    const update = () => {
      // update which section is active
      let activeClass = 'one';
      $copies.each((copy, index) => {
        const bounds = $(copy).bounds();
        if (bounds.top < window.innerHeight / 3) {
          activeClass = copySections[index];
        }
      });
      if (!$visual.hasClass(activeClass)) {
        allSections.forEach(s => $visual.removeClass(s));
        $visual.addClass(activeClass);
      }
    };

    $(window).on('scroll', update);
    update();
  </script>
  <ribbons>
    <ribbon class="tour">
      <UIContainer>
        <div class="right"></div>
        <div class="left">
          <div class="copy">
            <h4 class="sub header">Component Authoring</h4>
            <h3 class="header">Expressive Templates</h3>
            <p>Use javascript or list style expressions. Surgically update values with Signals against your data.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Use any javascript inside templates without arbitrary limitations
              </li>
              <li>
                <ui-icon check></ui-icon>
                Try out natural-language style Lisp syntax to improve comprehension during Huma in the Loop
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/templates">Templating Guide</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">Designed for Agents</h4>
            <h3 class="header">Specs as Code Contracts</h3>
            <p>Every component ships with a machine-readable spec. Agents read structured contracts to know exactly what's valid, what attributes compose, and what's appropriate.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Types, variations, and states with natural language descriptions
              </li>
              <li>
                <ui-icon check></ui-icon>
                <code>usageLevel</code> tells agents what's common vs. niche — no hallucinated <code>{`<ui-button instagram>`}</code> in a checkout flow
              </li>
              <li>
                <ui-icon check></ui-icon>
                Specs are a code contract that also inform usage patterns
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/specs">Component Specs</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">No Build Required</h4>
            <h3 class="header">Runtime Components</h3>
            <p>Define reactive web components with signals, Shadow DOM, and lifecycle hooks. Templates compile in the browser in under a millisecond — no bundler, no transpiler, no waiting.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Signals-based state with built-in helpers — <code>toggle()</code>, <code>increment()</code>, <code>push()</code>
              </li>
              <li>
                <ui-icon check></ui-icon>
                Shadow DOM scoping — <code>.primary</code> just works, no prefixes or modules
              </li>
              <li>
                <ui-icon check></ui-icon>
                Ship as standard ESM — works in any agent sandbox, CDN, or import map
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/components">Component Guide</UIButton>
          </div>
        </div>
      </UIContainer>
    </ribbon>
    <ribbon class="proof">
      <UIContainer>
        <UICards three spaced stackable>
          <ui-card>
            <ui-icon pdf></ui-icon>
            <div class="header">Designed for Agents</div>
            <div class="description">
              Components are powered by machine readable specs designed to translate from natural language to code.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon cpu></ui-icon>
            <div class="header">No Build Necessary</div>
            <div class="description">
              Signals, JSX style expression evaluation, and modern ESM running directly in the browser powered by web components.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon layers></ui-icon>
            <div class="header">Complete UI Library</div>
            <div class="description">
              A complete UI framework designed for compositionality and human in the loop editing. JIT Client-Side Tailwind inside Web Components too.
            </div>
          </ui-card>
        </UICards>
      </UIContainer>
    </ribbon>
    <ribbon>
      <UIContainer>
        <h3 class="ui header">
          See It In Action
        </h3>
        <PlaygroundExample height="800" id="card-search"></PlaygroundExample>
      </UIContainer>
    </ribbon>
  </ribbons>
  <footer>
    <UIContainer>
      <div class="columns">
        <div class="column">
          <h4><ui-icon zap></ui-icon> Get Started</h4>
          <a href="/ui/start">Introduction</a>
          <a href="/ui/start/install">Installation</a>
          <a href="/ui/start/why-semantic">Why Semantic?</a>
          <a href="/ui/start/whats-new">What's New?</a>
          <a href="/ui/roadmap">Roadmap</a>
        </div>
        <div class="column">
          <h4><ui-icon layers></ui-icon> UI Framework</h4>
          <a href="/ui/primitives">Primitives</a>
          <a href="/ui/components">Components</a>
          <a href="/ui/behaviors">Behaviors</a>
          <a href="/ui/css/tokens">CSS Tokens</a>
          <a href="/ui/css/concepts">Styling Guide</a>
        </div>
        <div class="column">
          <h4><ui-icon book-open></ui-icon> Guides</h4>
          <a href="/docs/guides/components">Components</a>
          <a href="/docs/guides/templates">Templates</a>
          <a href="/docs/guides/reactivity">Reactivity</a>
          <a href="/docs/guides/query">Query</a>
        </div>
        <div class="column">
          <h4><ui-icon code></ui-icon> API Reference</h4>
          <a href="/docs/api/component">Components</a>
          <a href="/docs/api/specs">Specs</a>
          <a href="/docs/api/reactivity">Reactivity</a>
          <a href="/docs/api/query">Query</a>
          <a href="/docs/api/utils">Utils</a>
        </div>
        <div class="column">
          <h4><ui-icon compass></ui-icon> Resources</h4>
          <a href="/examples/counter">Examples</a>
          <a href="/learn/selection">Learn</a>
          <a href="https://github.com/Semantic-Org/Semantic-Next" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="bottom">
        <span class="copyright">&copy; {new Date().getFullYear()} Semantic UI &middot; <a href="https://github.com/Semantic-Org/Semantic-Next/blob/main/LICENSE" target="_blank" rel="noopener">ISC License</a></span>
        <a href="https://github.com/Semantic-Org/Semantic-Next" target="_blank" rel="noopener" class="social">
          <ui-icon github></ui-icon>
        </a>
      </div>
    </UIContainer>
  </footer>
</Homepage>
