---
import Homepage from '../layouts/Homepage.astro';
import { Code } from '@astrojs/starlight/components';
import PlaygroundExample from '@components/PlaygroundExample/PlaygroundExample.astro';
import { CurrentTime } from '@components/CurrentTime.js'
import { UIButton, UIContainer, UICards } from '@semantic-ui/core'
import { Image } from 'astro:assets';
import logoImage from '@images/logo.png';

const code1=`
<ui-buttons>
  <ui-button subtle-negative>
    <ui-icon delete></ui-icon>
    Delete
  </ui-button>
  <ui-button>
    <ui-icon edit></ui-icon>
    Edit
  </ui-button>
  <ui-button primary>
    <ui-icon save></ui-icon>
    Save
  </ui-button>
</ui-buttons>
`.trim();
const code2=`
<user-panel>
  <h3 class="header">
    Welcome {getDisplayName (getUser userId) }
  </h3>
  <ui-buttons large>
    {#each action in actions}
      <ui-button {style}>
        <ui-icon {icon}>
        {text}
      </ui-button>
    {/each}
  </ui-buttons>
</user-panel>
`.trim();

---
<Homepage>
  <aboveFold>
    <canvas id="plasma"></canvas>
    <content>
      <UIContainer>
        <div class="text">
          <Image src={logoImage} alt="Logo" height="55" loading="eager" style="margin-bottom:2rem;"/>
          <h1>A New Language for UI</h1>
          <p>A <b>web component framework</b> and UI library designed for NL to code. <b>No build step. No framework lock-in.</b></p>
          <UIButton secondary href="/ui/start">View Docs</UIButton>
          <UIButton primary icon-after icon="right-chevron" href="/learn/selection">Try In 5 Minutes</UIButton>
        </div>
      </UIContainer>
    </content>
  </aboveFold>
  <script>
    import { createPlasma } from '../javascript/plasma.js'
    import { createGlobeUI } from '../javascript/hero-globe-ui.js'
    const plasma = createPlasma('#plasma', {
      // Colors — just hex
      colorFrom:       '#000000',
      colorTo:         '#0d6e8a',
      colorShift:       100,
      fps: false,

      // Specular
      specularTint:    '#1a99e6',
      specularPower:   2,
      specularAmbient: 0.5,

      // Animation
      speed:       0.2,
      density:     1.5,
      brightness:  0.3,
      resolution:  2,
      // Mouse interaction
      mouse: {
        light: 2,   // specular follows cursor
        warp:  1.5,   // gravity well pulls bands
      },
    });

    // createGlobeUI(document.querySelector('aboveFold'));
  </script>
  <ribbons>
    <ribbon class="proof">
      <UIContainer>
        <UICards three spaced stackable>
          <ui-card>
            <ui-icon pdf></ui-icon>
            <div class="header">Designed for Agents</div>
            <div class="description">
              Components are powered by machine readable specs designed to translate from natural language to code.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon cpu></ui-icon>
            <div class="header">No Build Necessary</div>
            <div class="description">
              Signals, JSX style expression evaluation, and modern ESM running directly in the browser powered by web components.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon layers></ui-icon>
            <div class="header">Complete UI Library</div>
            <div class="description">
              A complete UI framework designed for compositionality and human in the loop editing. JIT Client-Side Tailwind inside Web Components too.
            </div>
          </ui-card>
        </UICards>
      </UIContainer>
    </ribbon>
    <ribbon class="tour">
      <UIContainer>
        <div class="right">
          <div class="container">
            <div class="segment">
              <div class="one">
                <ui-buttons>
                  <ui-button subtle-negative>
                    <ui-icon delete></ui-icon>
                    Delete
                  </ui-button>
                  <ui-button>
                    <ui-icon edit></ui-icon>
                    Edit
                  </ui-button>
                  <ui-button primary>
                    <ui-icon save></ui-icon>
                    Save
                  </ui-button>
                </ui-buttons>
                <Code
                  code={code1}
                  lang="html"
                />
              </div>
              <div class="two">
                <Code
                  code={code2}
                  lang="sui"
                />
              </div>
              <div class="three">
                <!-- Example 3 !-->
              </div>
            </div>
          </div>
        </div>
        <div class="left">
          <div class="copy">
            <h4 class="sub header">Beautiful Markup</h4>
            <h3 class="header">Code Designed to Edit</h3>
            <p>Use AI to author websites that read like English so you can manually make tweaks and understand changes made.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Feature 1
              </li>
              <li>
                <ui-icon check></ui-icon>
                Feature 2
              </li>
              <li>
                <ui-icon check></ui-icon>
                Feature 3
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/ui/primitives">Browse Primitives</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">Component Authoring</h4>
            <h3 class="header">Author Components</h3>
            <p>Templates compile to an AST at runtime in the browser. Ternaries, arithmetic, inline objects, nested function calls, reactive expressions — full expressiveness without a compile step.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                <code>{`{isActive ? 'Yes' : 'No'}`}</code> — same expression power as JSX, no compiler required
              </li>
              <li>
                <ui-icon check></ui-icon>
                Lisp-style or JS-style calls — write templates the way you already think
              </li>
              <li>
                <ui-icon check></ui-icon>
                Templates are first-class values — pass them as component settings, swap layouts at runtime
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/templates">Templating Guide</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">Subheader 3</h4>
            <h3 class="header">Value Prop 3</h3>
            <p>Description of third</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Feature 1
              </li>
              <li>
                <ui-icon check></ui-icon>
                Feature 2
              </li>
              <li>
                <ui-icon check></ui-icon>
                Feature 3
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/reactivity">Reactivity Guide</UIButton>
          </div>
        </div>
      </UIContainer>
    </ribbon>
    <ribbon>
      <UIContainer>
        <h3 class="ui header">
          See It In Action
        </h3>
        <PlaygroundExample height="800" id="card-search"></PlaygroundExample>
      </UIContainer>
    </ribbon>
  </ribbons>
  <footer>

  </footer>
</Homepage>
