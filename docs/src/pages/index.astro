---
import Homepage from '../layouts/Homepage.astro';
import { Code } from '@astrojs/starlight/components';
import PlaygroundExample from '@components/PlaygroundExample/PlaygroundExample.astro';
import { CurrentTime } from '@components/CurrentTime.js'
import { UIButton, UIContainer, UICards } from '@semantic-ui/core'
import { Image } from 'astro:assets';
import logoImage from '@images/logo.png';

const code1=`
<ui-buttons large>
  <ui-button subtle-negative>
    <ui-icon x></ui-icon>
    Delete
  </ui-button>
  <ui-button>
    <ui-icon edit></ui-icon>
    Edit
  </ui-button>
  <ui-button primary>
    <ui-icon save></ui-icon>
    Save
  </ui-button>
</ui-buttons>
`.trim();
const code2=`
<user-panel>
  <h3 class="header">
    Welcome {getDisplayName (getUser userId) }
  </h3>
  <ui-buttons large>
    {#each action in actions}
      <ui-button {style}>
        <ui-icon {icon}>
        {text}
      </ui-button>
    {/each}
  </ui-buttons>
</user-panel>
`.trim();

---
<Homepage>
  <aboveFold>
    <canvas id="plasma"></canvas>
    <content>
      <UIContainer>
        <div class="text">
          <Image src={logoImage} alt="Logo" height="75" loading="eager" />
          <h1>From Prompt to Production</h1>
          <p>A <b>web component framework</b> and UI library designed for natural language to code. <b>No build step. No framework lock-in.</b></p>
          <UIButton secondary href="/ui/start">View Docs</UIButton>
          <UIButton primary icon-after icon="right-chevron" href="/learn/selection">Try In 5 Minutes</UIButton>
        </div>
      </UIContainer>
    </content>
  </aboveFold>
  <script>
    import { createPlasma } from '../javascript/plasma.js'

    const plasma = createPlasma('#plasma', {
      // Colors — just hex
      colorFrom:       '#000000',
      colorTo:         '#0d6e8a',
      colorShift:      -1000,
      fps: false,

      // Specular
      specularTint:    '#1a99e6',
      specularPower:   2,
      specularAmbient: 0.45,

      // Animation
      speed:       0.3,
      density:     1.5,
      brightness:  1.2,
      resolution:  2,
      // Mouse interaction
      mouse: {
        light: 2,   // specular follows cursor
        warp:  0.5,   // gravity well pulls bands
      },
    });
  </script>
  <ribbons>
    <ribbon class="proof">
      <UIContainer>
        <UICards three spaced stackable>
          <ui-card>
            <ui-icon cpu></ui-icon>
            <div class="header">AI Generates It. Browsers Run It.</div>
            <div class="description">
              No compiler between prompt and production. Components run natively in the browser — AI writes markup, users see UI. No webpack, no Vite, no build pipeline in between.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon pdf></ui-icon>
            <div class="header">From Human to AI</div>
            <div class="description">
              Components powered by machine readable specifications designed to translate from natural language to code.
            </div>
          </ui-card>
          <ui-card>
            <ui-icon layers></ui-icon>
            <div class="header">Complete UI Library</div>
            <div class="description">
              Use Tailwind or our CSS Token Framework. Ship complex UI using built-in primitives like button, menu, card.
            </div>
          </ui-card>
        </UICards>
      </UIContainer>
    </ribbon>
    <ribbon class="tour">
      <UIContainer>
        <div class="right">
          <div class="container">
            <div class="segment">
              <div class="one">
                <ui-buttons large>
                  <ui-button subtle-negative>
                    <ui-icon x></ui-icon>
                    Delete
                  </ui-button>
                  <ui-button>
                    <ui-icon edit></ui-icon>
                    Edit
                  </ui-button>
                  <ui-button primary>
                    <ui-icon save></ui-icon>
                    Save
                  </ui-button>
                </ui-buttons>
                <Code
                  code={code1}
                  lang="html"
                />
              </div>
              <div class="two">
                <Code
                  code={code2}
                  lang="sui"
                />
              </div>
            </div>
          </div>
        </div>
        <div class="left">
          <div class="copy">
            <h4 class="sub header">Primitives</h4>
            <h3 class="header">Markup That Reads Like English</h3>
            <p><code>&lt;ui-button primary large&gt;</code> — not <code>&lt;Button variant="primary" size="large" /&gt;</code>. Boolean attributes mean the markup reads the way you'd describe it, and the way an LLM would generate it.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                A growing library of first-party primitives — buttons, menus, cards, modals, inputs — built on the same framework you use
              </li>
              <li>
                <ui-icon check></ui-icon>
                Every component defined by a spec — natural language descriptions, valid attributes, example code — readable by humans, AI, and the framework itself
              </li>
              <li>
                <ui-icon check></ui-icon>
                Three dialects: boolean shorthand, explicit attributes, or class-based — same component, your preferred syntax
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/ui/primitives">Browse Primitives</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">Templating</h4>
            <h3 class="header">Templates Without a Compiler</h3>
            <p>Templates compile to an AST at runtime in the browser. Ternaries, arithmetic, inline objects, nested function calls, reactive expressions — full expressiveness without a compile step.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                <code>{`{isActive ? 'Yes' : 'No'}`}</code> — same expression power as JSX, no compiler required
              </li>
              <li>
                <ui-icon check></ui-icon>
                Single <code>{`{}`}</code> or double <code>{`{{}}`}</code> brackets, Lisp-style or JS-style calls — write templates the way you already think
              </li>
              <li>
                <ui-icon check></ui-icon>
                Templates are first-class values — pass them as component settings, swap layouts at runtime
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/templates">Templating Guide</UIButton>
          </div>
          <div class="copy">
            <h4 class="sub header">Reactivity</h4>
            <h3 class="header">Signals With Less Ceremony</h3>
            <p>Mutation helpers replace the <code>{`setState(prev => ...)`}</code> pattern. Auto-unwrapping means <code>{`{counter}`}</code> in a template just works — no <code>.value</code>, no <code>.get()</code>.</p>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                <code>increment()</code>, <code>toggle()</code>, <code>push()</code>, <code>setProperty()</code> — direct mutation instead of immutable update patterns
              </li>
              <li>
                <ui-icon check></ui-icon>
                Clone-by-default with deep equality — safe mutation without accidental reference sharing
              </li>
              <li>
                <ui-icon check></ui-icon>
                Standalone package — use the reactivity system with or without the component framework
              </li>
            </ul>
            <UIButton subtle icon-after icon="right-chevron" href="/docs/guides/reactivity">Reactivity Guide</UIButton>
          </div>
        </div>
      </UIContainer>
    </ribbon>
    <ribbon>
      <UIContainer>
        <h3 class="ui header">
          See It In Action
        </h3>
        <PlaygroundExample height="500" id="card-search"></PlaygroundExample>
      </UIContainer>
    </ribbon>
  </ribbons>
  <footer>

  </footer>
</Homepage>
