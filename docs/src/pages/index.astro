---
import Homepage from '../layouts/Homepage.astro';
import { Code } from '@astrojs/starlight/components';
import PlaygroundExample from '@components/PlaygroundExample/PlaygroundExample.astro';

const code1=`
<ui-buttons large>
  <ui-button subtle-negative>
    <ui-icon x></ui-icon>
    Delete
  </ui-button>
  <ui-button>
    <ui-icon edit></ui-icon>
    Edit
  </ui-button>
  <ui-button primary>
    <ui-icon save></ui-icon>
    Save
  </ui-button>
</ui-buttons>
`.trim();
const code2=`
<user-panel>
  <h3 class="header">
    Welcome {getDisplayName (getUser userId) }
  </h3>
  <ui-buttons large>
    {#each actions}
      <ui-button {style}>
        <ui-icon {icon}>
        {text}
      </ui-button>
    {/each}
  </ui-buttons>
</user-panel>
`.trim();

---
<Homepage>
  <aboveFold>
    <canvas id="gradient"></canvas>
    <content>
      <ui-container>
        <img src="/images/api-banner-image.png" class="image">
        <div class="text">
          <h1>Build Next-Gen Apps with Web Standards</h1>
          <p>Create truly <b>portable in house design systems</b> that work everywhere usings <b>web standards</b>, <b>signals-based reactivity</b>, and <b>robust ui primitives</b>. </p>
          <ui-button primary icon-after icon="right-chevron" href="/learn/selection">Try In 5 Minutes</ui-button>
          <ui-button secondary href="/components">View Docs</ui-button>
        </div>
      </ui-container>
    </content>
  </aboveFold>
  <script>
    import { Gradient } from '../javascript/gradient.js'
    const gradient = new Gradient()
    gradient.initGradient('#gradient')
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          entry.target.classList.toggle('offscreen', !entry.isIntersecting);
        });
      },
      {
        threshold: 0,
        rootMargin: '0px'
      }
    );
    const el = document.querySelector('aboveFold');
    observer.observe(el);
  </script>
  <ribbons>
    <ribbon class="proof">
      <ui-container>
        <ui-cards three spaced stackable>
          <ui-card>
            <ui-icon layers></ui-icon>
            <div class="header">Modern Foundations</div>
            <div class="description">
              Leverage <a href="/reactivity">Signals-based reactivity</a>,
              <a href="/templates">AST-based templating</a>,
              and robust css layers based theming framework.
            </div>
            <ui-button transparent inverted>Learn More</ui-button>
          </ui-card>
          <ui-card>
            <ui-icon unlock></ui-icon>
            <div class="header">Framework Agnostic</div>
            <div class="description">
              Author native <a href="/components">web components</a> that integrate seamlessly with <a href="https://react.dev/" target="_blank" rel="noopener noreferrer">React</a>, <a href="https://vuejs.org/" target="_blank" rel="noopener noreferrer">Vue</a>, Vanilla JS, or future frameworks.
            </div>
            <ui-button transparent inverted>Learn More</ui-button>
          </ui-card>
          <ui-card>
            <ui-icon tool></ui-icon>
            <div class="header">First Party UI</div>
            <div class="description">
              Start quickly with first-party <a href="/usage">UI primitives</a>, or craft custom components using web-standards and a powerful <a href="/components">authoring framework</a>.
            </div>
            <ui-button transparent inverted>Learn More</ui-button>
          </ui-card>
        </ui-cards>
        <!-- <div class="cards">
         <div class="card">
           <ui-icon layers></ui-icon>
           <h4 class="header">Enterprise Ready</h4>
           <p>Create apps with robust AST based templating, css layers based theming, and a composable architecture designed for large codebases.</p>
         </div>
        <div class="card">
          <ui-icon unlock></ui-icon>
          <h4 class="header">Zero Framework Lock-in</h4>
          <p>Author native web components that work in React, Vue, Vanilla JS, or whatever framework comes next. True interoperability without compromise.</p>
        </div>
         <div class="card">
           <ui-icon tool></ui-icon>
           <h4 class="header">Built to Customize</h4>
           <p>Hit the ground running with robust UI primitives, then author custom UI with a component framework designed for developer experience.</p>
         </div>
        </div> -->
      </ui-container>
    </ribbon>
    <ribbon class="tour">
      <ui-container>
        <div class="right">
          <div class="container">
            <div class="segment">
              <div class="one">
                <ui-buttons large>
                  <ui-button subtle-negative>
                    <ui-icon x></ui-icon>
                    Delete
                  </ui-button>
                  <ui-button>
                    <ui-icon edit></ui-icon>
                    Edit
                  </ui-button>
                  <ui-button primary>
                    <ui-icon save></ui-icon>
                    Save
                  </ui-button>
                </ui-buttons>
                <Code
                  code={code1}
                  lang="html"
                />
              </div>
              <div class="two">
                <Code
                  code={code2}
                  lang="sui"
                />
              </div>
            </div>
          </div>
        </div>
        <div class="left">
          <div class="copy">
            <h3 class="header">Build Interoperable UIs</h3>
            <p>Create components based on <a href="https://developer.mozilla.org/en-US/docs/Web/API/Web_components" target="_blank" rel="noopener noreferrer">Web Components</a> standards for use across different frameworks and projects. Leverage the <code><a href="/usage">@semantic-ui/core</a></code> library for common UI elements.</p>
            <h4 class="sub header">Key Benefits</h4>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Author components usable in <a href="https://react.dev/" target="_blank" rel="noopener noreferrer">React</a>, <a href="https://vuejs.org/" target="_blank" rel="noopener noreferrer">Vue</a>, <a href="https://angular.io/" target="_blank" rel="noopener noreferrer">Angular</a>, or Vanilla JS.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Consistent API for handling <a href="/components/settings">settings</a>, <a href="/components/styling">styling</a>, and <a href="/components/events">events</a>.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Compose complex UIs using standard browser technologies and SUI's <a href="/templates">templating features</a>.
              </li>
            </ul>
          </div>
          <div class="copy">
            <h3 class="header">Integrated Authoring Framework</h3>
            <p>Develop custom components efficiently with built-in solutions for reactivity, templating, DOM manipulation, and more.</p>
            <h4 class="sub header">Core Features</h4>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                <a href="/reactivity">Signals-based reactivity</a> for predictable state management.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Declarative <a href="/templates">AST-based templating</a> with <a href="/templates/expressions">expressions</a>, <a href="/templates/conditionals">conditionals</a>, <a href="/templates/loops">loops</a>, <a href="/templates/subtemplates">subtemplates</a>, and <a href="/templates/snippets">snippets</a>.
              </li>
              <li>
                <ui-icon check></ui-icon>
                <a href="/query/shadow-dom">Shadow DOM</a>-aware <a href="/query">querying library</a> (<code>@semantic-ui/query</code>).
              </li>
               <li>
                <ui-icon check></ui-icon>
                Performant rendering leveraging <a href="https://lit.dev" target="_blank" rel="noopener noreferrer">Lit</a>'s engine.
              </li>
            </ul>
          </div>
           <div class="copy">
            <h3 class="header">Designed for Developer Experience</h3>
            <p>Focus on building features with helpful abstractions and clear APIs designed for productivity.</p>
            <h4 class="sub header">Productivity Tools</h4>
            <ul class="feature-list">
              <li>
                <ui-icon check></ui-icon>
                Convenient <a href="/reactivity/mutation-helpers">mutation helpers</a> for updating reactive state.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Declarative syntax for handling <a href="/components/events">events</a> and <a href="/components/keys">key bindings</a>.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Comprehensive <a href="/components/lifecycle">lifecycle callbacks</a> for fine-grained control.
              </li>
              <li>
                <ui-icon check></ui-icon>
                Extensive set of utility functions in <code><a href="/api/utils">@semantic-ui/utils</a></code>.
              </li>
            </ul>
          </div>
        </div>
      </ui-container>
    </ribbon>
    <ribbon>
      <ui-container>
        <h3 class="ui header">
          Try It Out
        </h3>
        <PlaygroundExample height="500" id="card-search"></PlaygroundExample>
      </ui-container>
    </ribbon>
  </ribbons>
  <footer>

  </footer>
</Homepage>
