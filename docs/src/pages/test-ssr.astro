---
import Body from '../layouts/Body.astro';
import '../css/layers.css';
import '../css/fonts.css';

import { renderToString } from '@semantic-ui/component';
import { SSRDemo } from '@components/SSRDemo/SSRDemo.js';
import { Button } from '@semantic-ui/core';

// Server render components to DSD strings
const dsd = renderToString(SSRDemo, { title: 'SSR Demo' });
const buttonPrimary = renderToString(Button, { emphasis: 'primary' }, 'Primary');
const buttonDisabled = renderToString(Button, { disabled: true }, 'Disabled');
const buttonLink = renderToString(Button, { href: '/about' }, 'Link Button');
---
<Body class="dark">
<div style="padding: 24px; max-width: 600px;">

  <h1 style="color: white; font-family: sans-serif;">Native SSR Round-Trip Test</h1>

  <h2 style="color: white; font-family: sans-serif;">Primitives</h2>
  <div style="display: flex; gap: 12px; margin-bottom: 24px;">
    <Fragment set:html={buttonPrimary} />
    <Fragment set:html={buttonDisabled} />
    <Fragment set:html={buttonLink} />
  </div>

  <h2 style="color: white; font-family: sans-serif;">Custom Component</h2>
  <!-- Server-rendered component with DSD -->
  <Fragment set:html={dsd} />

  <details style="margin-top: 20px;">
    <summary style="color: #888; cursor: pointer;">Server HTML</summary>
    <pre style="color: #0f0; font-size: 12px; overflow: auto; max-height: 300px;">{dsd}</pre>
  </details>

  <pre id="log" style="color: #0f0; margin-top: 20px; font-size: 14px;"></pre>
</div>

<script>
  // Import the component on the client — same definition, registers the custom element,
  // connectedCallback detects existing shadow root from DSD and hydrates
  import { SSRDemo } from '@components/SSRDemo/SSRDemo.js';
  import { $ } from '@semantic-ui/query';

  // Wait for hydration
  const el = document.querySelector('ssr-demo');
  $(el).onNext('rendered').then(() => {
    const log = (msg) => {
      document.getElementById('log').textContent += msg + '\n';
    };

    log('Shadow root exists: ' + !!el.shadowRoot);
    log('Hydrated: ' + !!el.template);
    log('Items: ' + JSON.stringify(el.template?.state?.items?.get?.()));
    log('Content: ' + el.shadowRoot?.querySelector('.container')?.textContent?.trim().replace(/\s+/g, ' '));
  });
</script>
</Body>
