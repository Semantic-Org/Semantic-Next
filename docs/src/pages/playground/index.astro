---
  import Playground from '@layouts/Playground.astro';
  import { getSandboxURL } from '@helpers/playground.js';
  import CodePlayground from '@components/CodePlayground/CodePlayground.js';

  const sandboxURL = getSandboxURL();
---
<style>
  :root {
    --sidebar-width: 0px;
  }
</style>
<Playground>
  <CodePlayground client:only sandboxURL={sandboxURL} id="playground"></CodePlayground>
  <script>
    import { $ } from '@semantic-ui/query';
    import { readPlaygroundLink } from '@helpers/link-encoder.js';

    // Read files from URL
    const linkPromise = readPlaygroundLink(window.location.hash);

    $('astro-island').on('astro:hydrate', async () => {
      const link = await linkPromise;
      const files = link?.files || {};
      const $playground = $('code-playground#playground');
      if ($playground.exists()) {
        $playground
          .setting('files', files)
          .component().setFiles(files);
      }
    });
  </script>
</Playground>

