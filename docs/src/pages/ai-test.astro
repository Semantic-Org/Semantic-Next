---
import Homepage from '../layouts/Homepage.astro';
---
<Homepage>
  <div id="ai-test" style="max-width: 640px; margin: 80px auto; font-family: system-ui, sans-serif;">
    <h2>AI Generate — Proof of Concept</h2>

    <div id="prompt-area" style="display: flex; gap: 8px; margin-bottom: 16px;">
      <input
        id="prompt-input"
        type="text"
        placeholder="e.g. Make a delete button"
        maxlength="150"
        style="flex: 1; padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px;"
      />
      <button id="submit-btn" style="padding: 8px 16px; border: none; background: #2b6fb6; color: white; border-radius: 6px; cursor: pointer; font-size: 14px;">
        Send
      </button>
    </div>

    <div id="cot-line" style="font-size: 13px; color: #666; min-height: 20px; margin-bottom: 4px;"></div>
    <div id="note-line" style="font-size: 12px; color: #c47a00; min-height: 0; margin-bottom: 12px;"></div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div>
        <div style="font-size: 12px; text-transform: uppercase; color: #999; margin-bottom: 4px;">Preview</div>
        <div id="preview" style="padding: 16px; border: 1px solid #e0e0e0; border-radius: 6px; min-height: 60px;"></div>
      </div>
      <div>
        <div style="font-size: 12px; text-transform: uppercase; color: #999; margin-bottom: 4px;">Code</div>
        <pre id="code" style="padding: 16px; border: 1px solid #e0e0e0; border-radius: 6px; min-height: 60px; margin: 0; font-size: 13px; overflow-x: auto; white-space: pre-wrap;"></pre>
      </div>
    </div>

    <div style="margin-top: 12px; font-size: 12px; color: #999;">
      Model: <span id="model-display">—</span> | Prompt history: <span id="history-display">[]</span>
    </div>
  </div>

  <script is:inline>
    const API_BASE = 'https://ai.semantic-ui.com';

    const input = document.getElementById('prompt-input');
    const submitBtn = document.getElementById('submit-btn');
    const cotLine = document.getElementById('cot-line');
    const noteLine = document.getElementById('note-line');
    const preview = document.getElementById('preview');
    const code = document.getElementById('code');
    const historyDisplay = document.getElementById('history-display');
    const modelDisplay = document.getElementById('model-display');

    let currentHTML = '';
    let promptHistory = [];
    let streaming = false;

    async function generate() {
      const prompt = input.value.trim();
      if (!prompt || streaming) return;

      streaming = true;
      submitBtn.disabled = true;
      submitBtn.textContent = '...';
      cotLine.textContent = '';
      noteLine.textContent = '';
      code.textContent = '';

      try {
        // get token
        const tokenRes = await fetch(`${API_BASE}/api/token`, { method: 'POST' });
        const { token, error: tokenError } = await tokenRes.json();
        if (tokenError) throw new Error(tokenError);

        // start generate stream
        const res = await fetch(`${API_BASE}/api/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            token,
            prompt,
            currentHTML,
            promptHistory,
            component: 'button',
            syntax: 'succinct',
            model: 'deepseek',
          }),
        });

        if (!res.ok) {
          const err = await res.json();
          throw new Error(err.error || 'Request failed');
        }

        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let htmlAccum = '';
        let buffer = '';

        while (true) {
          const { done, value } = await reader.read();
          if (done) break;

          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop(); // keep incomplete line in buffer

          for (const line of lines) {
            if (!line.startsWith('data: ')) continue;
            const data = JSON.parse(line.slice(6));

            if (data.type === 'cot') {
              cotLine.textContent = data.text;
            } else if (data.type === 'note') {
              noteLine.textContent = data.text;
            } else if (data.type === 'html') {
              htmlAccum += data.text;
              code.textContent = htmlAccum;
            } else if (data.type === 'done') {
              currentHTML = htmlAccum.trim();
              preview.innerHTML = currentHTML;
              promptHistory.push({ prompt, html: currentHTML });
              historyDisplay.textContent = JSON.stringify(promptHistory.map(t => t.prompt));
              modelDisplay.textContent = data.text || '—';
              input.value = '';
            } else if (data.type === 'error') {
              cotLine.textContent = 'Error: ' + data.text;
            }
          }
        }
      } catch (err) {
        cotLine.textContent = 'Error: ' + err.message;
      } finally {
        streaming = false;
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    }

    submitBtn.addEventListener('click', generate);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') generate();
    });
  </script>
</Homepage>
