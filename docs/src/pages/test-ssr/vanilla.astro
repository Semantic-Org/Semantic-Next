---
/*
  Vanilla SSR Test — No Astro integration.
  Uses renderToString directly to produce DSD HTML.
  Tests the ServerRenderer + hydration path in isolation.
*/
import Body from '../../layouts/Body.astro';
import '../../css/layers.css';
import '../../css/fonts.css';

import { renderToString } from '@semantic-ui/component';
import { NavMenu } from '@semantic-ui/core';

const menu = [
  { name: 'Introduction', url: '/intro', icon: 'book' },
  { name: 'Getting Started', url: '/start', icon: 'zap', pages: [
    { name: 'Installation', url: '/install' },
    { name: 'Quick Start', url: '/quick' },
  ]},
  { name: 'Components', url: '/components', icon: 'puzzle', pages: [
    { name: 'Button', url: '/button' },
    { name: 'Icon', url: '/icon' },
    { name: 'Input', url: '/input' },
  ]},
];

const html = renderToString(NavMenu, {
  menu,
  expandAll: true,
  dark: true,
  activeURL: '/install',
}, '');
---
<Body class="dark">
<div style="padding: 24px; max-width: 400px; font-family: sans-serif;">
  <h2 style="color: white; margin-bottom: 16px;">SSR Component Test</h2>
  <Fragment set:html={html} />
</div>
</Body>
