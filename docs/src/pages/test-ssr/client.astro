---
import Body from '@layouts/Body.astro';
import '@css/layers.css';
import '@css/fonts.css';
import '@semantic-ui/core/icon/sets/lucide.css';
---
<Body class="dark">
<style>
  .test-wrapper {
    padding: 24px;
    max-width: 400px;
  }
  .test-wrapper h2 {
    color: white;
    margin-bottom: 16px;
  }
</style>
<div class="test-wrapper">
  <h2>SSR Component Test</h2>
  <nav-menu id="test-menu" expand-all searchable dark active-u-r-l="/install"></nav-menu>
</div>
<script>
  import { NavMenu } from '@semantic-ui/core';
  import { $ } from '@semantic-ui/query';

  const menu = [
    { name: 'Introduction', url: '/intro', icon: 'book' },
    { name: 'Getting Started', url: '/start', icon: 'zap', pages: [
      { name: 'Installation', url: '/install' },
      { name: 'Quick Start', url: '/quick' },
    ]},
    { name: 'Components', url: '/components', icon: 'puzzle', pages: [
      { name: 'Button', url: '/button' },
      { name: 'Icon', url: '/icon' },
      { name: 'Input', url: '/input' },
    ]},
  ];

  $('#test-menu').settings({ menu });
</script>
</Body>
