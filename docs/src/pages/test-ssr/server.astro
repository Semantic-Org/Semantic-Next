---
import Body from '@layouts/Body.astro';
import '@css/layers.css';
import '@css/fonts.css';
import '@semantic-ui/core/icon/sets/lucide.css';

import { Menu } from '@semantic-ui/core';

const categoryMenu = [
  { label: 'Guide', href: '/docs/guides', icon: 'book', active: true },
  { label: 'API Reference', href: '/docs/api', icon: 'code' },
];
---
<Body class="dark">
<style>
  .test-wrapper {
    padding: 24px;
    max-width: 400px;
  }
  .test-wrapper h2 {
    color: white;
    margin-bottom: 16px;
  }
</style>
<div class="test-wrapper">
  <h2>SSR Server Test</h2>
  <Menu
    items={categoryMenu}
    vertical
    selection
    dark
  />
</div>
</Body>
