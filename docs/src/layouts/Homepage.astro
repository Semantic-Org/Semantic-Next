---
import '../css/layers.css';
import '../css/fonts.css';
import '../css/code-formatting.css';
import '@semantic-ui/core/icon/sets/lucide.css';
import Body from '../layouts/Body.astro';
import TopBar from '@components/TopBar.astro';
import { NavMenu } from '@semantic-ui/core';
import SiteMobileMenu from '@components/SiteMobileMenu.astro';
import './Layout.css';
import './Homepage.css';
import '../css/hero-demo.css';
let { title, description, searchMeta } = Astro.props;
---
<Body title={title} description={description} searchMeta={searchMeta} prefetch>
  <TopBar floating showThemeSwitcher=false />
  <page data-pagefind-body>
    <slot></slot>
  </page>
  <SiteMobileMenu></SiteMobileMenu>
</Body>
