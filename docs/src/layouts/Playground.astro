---
import '../css/layers.css';
import '../css/fonts.css';

import Body from '../layouts/Body.astro';
import TopBar from '@components/TopBar.astro';
import SiteMobileMenu from '@components/SiteMobileMenu.astro';

import './Layout.css';
import './Playground.css';
let { title, description, searchMeta } = Astro.props;
if(!title) {
  title = searchMeta?.title;
}
---
<Body title={title} description={description} searchMeta={searchMeta} >
  <script is:inline slot="head">
      // Register service worker
    const registerCdnRedirector = async () => {
      if ('serviceWorker' in navigator) {
        try {
          const registration = await navigator.serviceWorker.register(
            '/cdn-redirector.js?v=3',
            { scope: '/' }
          );

          // Force immediate activation if needed
          if (registration.waiting) {
            registration.waiting.postMessage({ type: 'SKIP_WAITING' });
          }

          console.log('CDN redirector registered');
          return registration;
        } catch (error) {
          console.error('CDN redirector registration failed:', error);
          return null;
        }
      }
      return null;
    };

    // Unregister service worker (for rollback)
    const unregisterCdnRedirector = async () => {
      const registrations = await navigator.serviceWorker.getRegistrations();
      let found = false;

      for (const registration of registrations) {
        if (registration.active && registration.active.scriptURL.includes('cdn-redirector.js')) {
          await registration.unregister();
          found = true;
          console.log('CDN redirector unregistered');
        }
      }

      return found;
    };

    // remove for now
    unregisterCdnRedirector();
  </script>
  <layout id="playground">
    <TopBar noanimation/>
    <slot></slot>
  </layout>
  <SiteMobileMenu></SiteMobileMenu>
</Body>
