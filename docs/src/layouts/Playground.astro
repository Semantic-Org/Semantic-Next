---
import '../css/layers.css';
import '../css/fonts.css';

import Body from '../layouts/Body.astro';
import TopBar from '@components/TopBar.astro';
import SiteMobileMenu from '@components/SiteMobileMenu.astro';

import './Layout.css';
import './Playground.css';
let { title, description, searchMeta } = Astro.props;
---
<script is:inline>
  const registerCdnRedirector = async () => {
    if ('serviceWorker' in navigator) {
      try {
        // Register our CDN redirector service worker with a scope that includes
        // the playground's service worker scope
        const registration = await navigator.serviceWorker.register(
          '/cdn-redirector.js',
          {
            scope: '/',  // Cover the entire origin to catch all CDN requests
          }
        );

        // Force it to activate immediately if needed
        if (registration.waiting) {
          registration.waiting.postMessage({ type: 'SKIP_WAITING' });
        }
        return true;
      } catch (error) {
        return false;
      }
    }
  };
  registerCdnRedirector();
</script>
<Body title={title} description={description} searchMeta={searchMeta} >
  <layout id="playground">
    <TopBar noanimation/>
    <slot></slot>
  </layout>
  <SiteMobileMenu></SiteMobileMenu>
</Body>
