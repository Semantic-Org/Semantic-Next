---
const { sidebarMenu, sidebarHeader, expandAll } = Astro.props;
import './Sidebar.css';
import { NavMenu, SidebarToggle } from '@semantic-ui/core';
import { getSidebarMenu, getActiveSidebarSection, getSidebarNavMenu } from '@helpers/navigation.js';
import { Menu } from '@semantic-ui/core';

const menu = sidebarMenu || await getSidebarMenu({url: Astro.url.pathname});

// trying out always expanded for now
const canExpand = true; 

const currentPath = Astro.url.pathname;
const activeSection = getActiveSidebarSection(currentPath);
const sidebarNavMenu = getSidebarNavMenu(activeSection, currentPath);

const showSidebarNav = (sidebarNavMenu.length > 0);
const sidebarSubheader = sidebarHeader || (showSidebarNav) ? 'Categories' : 'Navigation';
---
<script>
import { $$ } from '@semantic-ui/query';
import { Tooltip } from '@semantic-ui/core';

const isCollapsed = () => {
  return document.documentElement.classList.contains('sidebar-collapsed')
    || document.querySelector('sidebar')?.classList.contains('collapsed');
};

// Add tooltips to category menu items (only show when collapsed)
$$('sidebar ui-menu menu-item').each((el) => {
  const $el = $$(el);
  const label = $el.find('.label').text();
  if (label) {
    $el.tooltip({
      text: label,
      position: 'right',
      preserve: true,
      delay: 500,
      topLayer: true,
      containToScroll: false,
      onShow: () => !!isCollapsed(),
    });
  }
});
</script>
<sidebar transition:persist id="sidebar" popover="manual">
  <slot/>
  <SidebarToggle client:load/>
  <div class="subheader">{sidebarSubheader}</div>
  {
    showSidebarNav && (
      <Menu
        items={sidebarNavMenu}
        vertical
        selection
        dark
      />
    )
  }
  <NavMenu
    client:load
    menu={menu}
    expand-all={expandAll || canExpand}
    use-accordion=false
    activeURL={Astro.url.pathname}
    searchable
    aligned
    dark
  />
  <slot name="after"/>
</sidebar>
