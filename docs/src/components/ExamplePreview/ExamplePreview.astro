---
import { getCollection } from 'astro:content';
import { getExampleFiles, getExampleID, getSandboxURL } from '@helpers/playground.js';
import { getFolder } from '@helpers/loading.js';

import ExamplePreviewElement from './ExamplePreview.js';

const { id, height } = Astro.props;
const matchingExamples = await getCollection('examples', ({ data }) => {
  return getExampleID(data) == id;
});
if(!matchingExamples[0]) {
  throw new Error(`Could not find example ${id}`);
}
const example = matchingExamples[0].data;
const allExampleFiles = await getFolder(getExampleID(example), '../../examples/');
const files = await getExampleFiles({
  contentID: getExampleID(example),
  allFiles: allExampleFiles,
  basePath: '../../examples/',
  includeFolder: example.exampleType == 'folder',
  includePlaygroundInjections: true,
});
const sandboxURL = getSandboxURL();
const style = height ? `--example-preview-height: ${height}px;` : undefined;
---
<ExamplePreviewElement client:only
  files={files}
  sandboxURL={sandboxURL}
  style={style}
></ExamplePreviewElement>
