---
import {
  UIButton,
  UIButtons,
  UICard,
  UICards,
  UIContainer,
  UIDivider,
  UIIcon,
  UIInput,
  UILabel,
  UIMenu,
  MenuItem,
  UIInput,
  UIRail,
  UISegment,
  UISegments,
  UISpinner,
  UITable,
} from '@semantic-ui/core';
import { inArray } from '@semantic-ui/utils';

const { name, tagName, attributes } = Astro.props;
const componentName = tagName || name;
---

{inArray(componentName, ['ui-button', 'UIButton']) && (
  <UIButton {...attributes} client:visible>
    <slot />
  </UIButton>
)}
{inArray(componentName, ['ui-segment', 'UISegment']) && (
  <UISegment {...attributes} client:visible>
    <slot />
  </UISegment>
)}
{inArray(componentName, ['ui-segments', 'UISegments']) && (
  <UISegments {...attributes} client:visible>
    <slot />
  </UISegments>
)}
{inArray(componentName, ['ui-buttons', 'UIButtons']) && (
  <UIButtons {...attributes} client:visible>
    <slot />
  </UIButtons>
)}
{inArray(componentName, ['ui-card', 'UICard']) && (
  <UICard {...attributes} client:visible>
    <slot />
  </UICard>
)}
{inArray(componentName, ['ui-cards', 'UICards']) && (
  <UICards {...attributes} client:visible>
    <slot />
  </UICards>
)}

{inArray(componentName, ['ui-container', 'UIContainer']) && (
  <UIContainer {...attributes}>
    <slot />
  </UIContainer>
)}

{inArray(componentName, ['ui-divider', 'UIDivider']) && (
  <UIDivider {...attributes} client:visible>
    <slot />
  </UIDivider>
)}

{inArray(componentName, ['ui-icon', 'UIIcon']) && (
  <UIIcon {...attributes} />
)}

{inArray(componentName, ['ui-input', 'UIInput']) && (
  <UIInput {...attributes} />
)}

{inArray(componentName, ['ui-label', 'UILabel']) && (
  <UILabel {...attributes} client:visible>
    <slot />
  </UILabel>
)}

{inArray(componentName, ['ui-rail', 'UIRail']) && (
  <UIRail {...attributes}>
    <slot />
  </UIRail>
)}
{inArray(componentName, ['ui-menu', 'UIMenu']) && (
  <UIMenu {...attributes} client:visible>
    <slot />
  </UIMenu>
)}
{inArray(componentName, ['menu-item', 'MenuItem']) && (
  <MenuItem {...attributes} client:visible>
    <slot />
  </MenuItem>
)}
{inArray(componentName, ['ui-spinner', 'UISpinner']) && (
  <UISpinner {...attributes} client:visible />
)}
{inArray(componentName, ['ui-table', 'UITable']) && (
  <UITable {...attributes} client:visible>
    <slot />
  </UITable>
)}
